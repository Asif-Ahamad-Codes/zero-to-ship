{
  "name": "zero-to-shipped-resume-parser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "start:backend": "npm run start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
